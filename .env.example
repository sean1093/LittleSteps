# Firebase Configuration
# Copy this file to .env.local and fill in your Firebase credentials
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id
# Firebase console > Realtime Database. Required: without it the SDK derives a
# us-central1 host from the project id, and this database is in asia-southeast1.
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app

# App Check (reCAPTCHA v3). Leave the site key empty until the web app is
# registered under Firebase console > App Check; with no key the app runs
# without App Check.
VITE_FIREBASE_APPCHECK_SITE_KEY=
# Development only: print a debug token to the console, to be registered under
# App Check > Apps > Manage debug tokens. A production build never reads it.
VITE_FIREBASE_APPCHECK_DEBUG=false
