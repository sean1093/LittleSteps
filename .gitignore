# Database 模擬器每次執行都會在 repo 根目錄留一份
database-debug.log
firebase-debug.log
firestore-debug.log
ui-debug.log

# 資料庫搬遷的備份（scripts/migrateChildRecords.cjs）。一個檔案就是每一個家庭
# 完整的健康紀錄，絕不進版控
backups/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
# Playwright MCP 的逐次輸出，屬於工具產物，不進版控
.playwright-mcp/

# Playwright 的報告、trace 與失敗截圖：每次執行都會重生，且 trace 內含整頁
# 快照，不進版控。不綁根目錄：agent 的 worktree 是這個 repo 的第二份複本，
# 在裡面跑測試同樣會產出這三個目錄。
playwright-report/
test-results/
blob-report/

# Agent worktree（`.claude/worktrees/`）是完整的 repo 複本。沒有忽略的話，
# 主目錄的 git status 會把整份複本列成未追蹤檔案。
.claude/worktrees/

# SDD isolated worktrees
.worktrees/
*.tsbuildinfo
