{
  "rules": {
    "users": {
      "$userId": {
        ".read": "$userId === auth.uid",
        ".write": "$userId === auth.uid"
      }
    },
    "children": {
      "$childId": {
        ".read": "root.child('users').child(auth.uid).child('childrenIds').child($childId).val() === true",
        ".write": "root.child('users').child(auth.uid).child('childrenIds').child($childId).val() === true || (!data.exists() && auth != null)"
      }
    },
    "childIndex": {
      "$childId": {
        ".read": "auth != null",
        ".write": "root.child('users').child(auth.uid).child('childrenIds').child($childId).val() === true"
      }
    },
    "feedbacks": {
      "$feedbackId": {
        ".read": "false",
        ".write": "auth != null && !data.exists() && newData.child('userId').val() === auth.uid"
      }
    }
  }
}
