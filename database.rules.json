{
  "rules": {
    "users": {
      "$userId": {
        ".read": "$userId === auth.uid",
        ".write": "$userId === auth.uid"
      }
    },

    "children": {
      "$childId": {
        ".read": "data.child('members').child(auth.uid).val() === true",
        ".write": "data.child('members').child(auth.uid).val() === true || (!data.exists() && newData.child('members').child(auth.uid).val() === true)",
        ".validate": "newData.hasChildren(['name', 'createdBy', 'members'])",

        "name": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "birthday": { ".validate": "newData.isString() && newData.val().length <= 10" },
        "createdBy": { ".validate": "newData.isString() && newData.val().length <= 128" },
        "joinOpen": { ".validate": "newData.isBoolean()" },

        "members": {
          "$memberUid": {
            ".write": "auth != null && ($memberUid === auth.uid || data.parent().child(auth.uid).val() === true) && (newData.exists() || $memberUid !== root.child('children').child($childId).child('createdBy').val()) && (!newData.exists() || data.exists() || data.parent().child(auth.uid).val() === true || root.child('children').child($childId).child('joinOpen').val() === true)",
            ".validate": "newData.val() === true"
          }
        }
      }
    },

    "childRecords": {
      "$childId": {
        ".read": "root.child('children').child($childId).child('members').child(auth.uid).val() === true",
        ".write": "root.child('children').child($childId).child('members').child(auth.uid).val() === true"
      }
    },

    "childIndex": {
      "$childId": {
        ".read": "auth != null",
        ".write": "root.child('children').child($childId).child('members').child(auth.uid).val() === true"
      }
    },

    "feedbacks": {
      "$feedbackId": {
        ".read": "false",
        ".write": "auth != null && !data.exists() && newData.child('userId').val() === auth.uid",
        ".validate": "newData.hasChildren(['title', 'content', 'userId'])",
        "title": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "content": { ".validate": "newData.isString() && newData.val().length <= 5000" },
        "userId": { ".validate": "newData.isString() && newData.val().length <= 128" },
        "userEmail": { ".validate": "newData.isString() && newData.val().length <= 320" },
        "userName": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "id": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "timestamp": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "createdAt": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "$other": { ".validate": false }
      }
    }
  }
}
