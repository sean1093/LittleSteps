{
  "rules": {
    "users": {
      "$userId": {
        ".read": "$userId === auth.uid",
        ".write": "$userId === auth.uid",

        "childrenIds": {
          "$childId": { ".validate": "newData.val() === true" }
        },
        "currentChildId": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "$other": { ".validate": false }
      }
    },

    "children": {
      "$childId": {
        ".read": "data.child('members').child(auth.uid).val() === true",
        ".write": "data.child('members').child(auth.uid).val() === true || (!data.exists() && newData.child('members').child(auth.uid).val() === true)",
        ".validate": "newData.hasChildren(['name', 'createdBy', 'members'])",

        "id": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "name": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "birthday": { ".validate": "newData.isString() && newData.val().length <= 10" },
        "gender": { ".validate": "newData.val() === 'male' || newData.val() === 'female'" },
        "gestationalAgeWeeks": { ".validate": "newData.isNumber() && newData.val() >= 20 && newData.val() <= 42" },
        "gestationalAgeDays": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 6" },
        "isPregnancy": { ".validate": "newData.isBoolean()" },
        "createdAt": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "createdBy": { ".validate": "newData.isString() && newData.val().length <= 128" },
        "joinOpen": { ".validate": "newData.isBoolean()" },

        "members": {
          "$memberUid": {
            ".write": "auth != null && ($memberUid === auth.uid || data.parent().child(auth.uid).val() === true) && (newData.exists() || $memberUid !== root.child('children').child($childId).child('createdBy').val()) && (!newData.exists() || data.exists() || data.parent().child(auth.uid).val() === true || root.child('children').child($childId).child('joinOpen').val() === true)",
            ".validate": "newData.val() === true"
          }
        },

        "pregnancyData": {
          "childId": { ".validate": "newData.isString() && newData.val().length <= 64" },
          "dueDate": { ".validate": "newData.isString() && newData.val().length <= 10" },
          "lastPeriodDate": { ".validate": "newData.isString() && newData.val().length <= 10" },
          "status": { ".validate": "newData.val() === 'active' || newData.val() === 'archived'" },
          "$other": { ".validate": false }
        },

        "milestoneProgress": {
          "$milestoneId": {
            ".validate": "newData.hasChildren(['achieved'])",
            "achieved": { ".validate": "newData.isBoolean()" },
            "achievedDate": { ".validate": "newData.isString() && newData.val().length <= 10" },
            "$other": { ".validate": false }
          }
        },

        "vaccineProgress": {
          "$vaccineId": {
            "doses": {
              "$doseNumber": {
                ".validate": "newData.hasChildren(['administered'])",
                "administered": { ".validate": "newData.isBoolean()" },
                "administeredDate": { ".validate": "newData.isString() && newData.val().length <= 10" },
                "$other": { ".validate": false }
              }
            },
            "$other": { ".validate": false }
          }
        },

        "developmentProgress": {
          "$checkItemId": {
            ".validate": "newData.hasChildren(['achieved'])",
            "achieved": { ".validate": "newData.isBoolean()" },
            "achievedDate": { ".validate": "newData.isString() && newData.val().length <= 10" },
            "$other": { ".validate": false }
          }
        },

        "toothProgress": {
          "$toothId": {
            ".validate": "newData.hasChildren(['erupted'])",
            "erupted": { ".validate": "newData.isBoolean()" },
            "eruptedDate": { ".validate": "newData.isString() && newData.val().length <= 10" },
            "$other": { ".validate": false }
          }
        },

        "prenatalProgress": {
          "$templateId": {
            ".validate": "newData.hasChildren(['completedDate'])",
            "completedDate": { ".validate": "newData.isString() && newData.val().length <= 10" },
            "clinicName": { ".validate": "newData.isString() && newData.val().length <= 100" },
            "notes": { ".validate": "newData.isString() && newData.val().length <= 2000" },
            "$other": { ".validate": false }
          }
        },

        "careTaskProgress": {
          "$taskId": {
            ".validate": "newData.hasChildren(['completedDate'])",
            "taskId": { ".validate": "newData.isString() && newData.val().length <= 64" },
            "completedDate": { ".validate": "newData.isString() && newData.val().length <= 10" },
            "location": { ".validate": "newData.isString() && newData.val().length <= 100" },
            "notes": { ".validate": "newData.isString() && newData.val().length <= 2000" },
            "$other": { ".validate": false }
          }
        },

        "foodTrackingProgress": {
          "$foodId": {
            ".validate": "newData.hasChildren(['foodName'])",
            "id": { ".validate": "newData.isString() && newData.val().length <= 64" },
            "foodName": { ".validate": "newData.isString() && newData.val().length <= 100" },
            "category": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "firstTriedDate": { ".validate": "newData.isString() && newData.val().length <= 10" },
            "trialDates": {
              "$i": { ".validate": "newData.isString() && newData.val().length <= 10" }
            },
            "hasAllergy": { ".validate": "newData.isBoolean()" },
            "allergyReactions": {
              "$i": {
                "type": { ".validate": "newData.val() === 'rash' || newData.val() === 'diarrhea' || newData.val() === 'vomiting' || newData.val() === 'constipation' || newData.val() === 'runny_nose' || newData.val() === 'cough' || newData.val() === 'eczema' || newData.val() === 'other'" },
                "severity": { ".validate": "newData.val() === 'mild' || newData.val() === 'moderate' || newData.val() === 'severe'" },
                "description": { ".validate": "newData.isString() && newData.val().length <= 500" },
                "date": { ".validate": "newData.isString() && newData.val().length <= 10" },
                "$other": { ".validate": false }
              }
            },
            "preference": { ".validate": "newData.val() === 'love' || newData.val() === 'like' || newData.val() === 'neutral' || newData.val() === 'dislike' || newData.val() === 'refuse'" },
            "notes": { ".validate": "newData.isString() && newData.val().length <= 2000" },
            "createdAt": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "updatedAt": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "$other": { ".validate": false }
          }
        },

        "$other": { ".validate": false }
      }
    },

    "childRecords": {
      "$childId": {
        ".read": "root.child('children').child($childId).child('members').child(auth.uid).val() === true",
        ".write": "root.child('children').child($childId).child('members').child(auth.uid).val() === true",

        "dailyLogs": {
          "$logId": {
            ".validate": "newData.hasChildren(['type', 'timestamp', 'data', 'createdAt'])",
            "id": { ".validate": "newData.isString() && newData.val().length <= 64" },
            "childId": { ".validate": "newData.val() === $childId" },
            "type": { ".validate": "newData.val() === 'feeding' || newData.val() === 'sleep' || newData.val() === 'diaper'" },
            "timestamp": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "createdAt": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "updatedAt": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "createdBy": { ".validate": "newData.isString() && newData.val().length <= 128" },
            "createdByName": { ".validate": "newData.isString() && newData.val().length <= 200" },
            "data": {
              ".validate": "newData.hasChildren()",
              "feedingType": { ".validate": "newData.val() === 'breast_left' || newData.val() === 'breast_right' || newData.val() === 'breast_both' || newData.val() === 'breast_milk_bottle' || newData.val() === 'formula' || newData.val() === 'solid' || newData.val() === 'pumping'" },
              "amount": { ".validate": "newData.isNumber()" },
              "duration": { ".validate": "newData.isNumber()" },
              "side": { ".validate": "newData.val() === 'left' || newData.val() === 'right' || newData.val() === 'both'" },
              "startTime": { ".validate": "newData.isString() && newData.val().length <= 40" },
              "endTime": { ".validate": "newData.isString() && newData.val().length <= 40" },
              "nightWakings": { ".validate": "newData.isNumber()" },
              "type": { ".validate": "newData.val() === 'pee' || newData.val() === 'poop' || newData.val() === 'both'" },
              "consistency": { ".validate": "newData.val() === 'normal' || newData.val() === 'soft' || newData.val() === 'hard'" },
              "notes": { ".validate": "newData.isString() && newData.val().length <= 2000" },
              "$other": { ".validate": false }
            },
            "$other": { ".validate": false }
          }
        },

        "diaryEntries": {
          "$entryId": {
            ".validate": "newData.hasChildren(['date', 'content', 'createdAt'])",
            "id": { ".validate": "newData.isString() && newData.val().length <= 64" },
            "childId": { ".validate": "newData.val() === $childId" },
            "date": { ".validate": "newData.isString() && newData.val().matches(/^\\d{4}-\\d{2}-\\d{2}$/)" },
            "content": { ".validate": "newData.isString() && newData.val().length <= 5000" },
            "mood": { ".validate": "newData.val() === 'happy' || newData.val() === 'proud' || newData.val() === 'tired' || newData.val() === 'worried' || newData.val() === 'funny'" },
            "linkedCheckItemId": { ".validate": "newData.isString() && newData.val().length <= 64" },
            "createdAt": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "updatedAt": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "$other": { ".validate": false }
          }
        },

        "growthRecords": {
          "$recordId": {
            ".validate": "newData.hasChildren(['date'])",
            "id": { ".validate": "newData.isString() && newData.val().length <= 64" },
            "childId": { ".validate": "newData.val() === $childId" },
            "date": { ".validate": "newData.isString() && newData.val().matches(/^\\d{4}-\\d{2}-\\d{2}$/)" },
            "weight": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 50" },
            "height": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 150" },
            "headCircumference": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 70" },
            "percentile": {
              "weight": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
              "height": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
              "headCircumference": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
              "$other": { ".validate": false }
            },
            "notes": { ".validate": "newData.isString() && newData.val().length <= 2000" },
            "$other": { ".validate": false }
          }
        },

        "$other": { ".validate": false }
      }
    },

    "childIndex": {
      "$childId": {
        ".read": "auth != null",
        ".write": "root.child('children').child($childId).child('members').child(auth.uid).val() === true"
      }
    },

    "feedbacks": {
      "$feedbackId": {
        ".read": "false",
        ".write": "auth != null && !data.exists() && newData.child('userId').val() === auth.uid",
        ".validate": "newData.hasChildren(['title', 'content', 'userId'])",
        "title": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "content": { ".validate": "newData.isString() && newData.val().length <= 5000" },
        "userId": { ".validate": "newData.isString() && newData.val().length <= 128" },
        "userEmail": { ".validate": "newData.isString() && newData.val().length <= 320" },
        "userName": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "id": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "timestamp": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "createdAt": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "$other": { ".validate": false }
      }
    }
  }
}
